@echo off
rem STARTUP.CMD lines for the QCA6174 driver.
rem The driver cannot read files during boot, so the two ath10k firmware files (linux-firmware,
rem ath10k/QCA6174/hw3.0/) are copied into it once per boot. Board file first or firmware first: either order.
copy /b C:\IBMCOM\MACS\QCA6174\firmware-6.bin \DEV\WRND32$ > nul
copy /b C:\IBMCOM\MACS\QCA6174\board-2.bin \DEV\WRND32$ > nul
rem The adapter starts on the first request of the Wireless LAN Monitor or wpa_supplicant. To start it now
rem (and see the result on COM1):  echo up > \DEV\WRND32$
rem The state can be read at any time:  copy \DEV\WRND32$ con

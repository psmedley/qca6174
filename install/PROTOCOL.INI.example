[PROT_MAN]

   DRIVERNAME = PROTMAN$

[IBMLXCFG]

   TCPIP_NIF = TCPIP.NIF
   QCA6174_NIF = QCA6174.NIF

[TCPIP_NIF]

   DriverName = TCPIP$
   Bindings = QCA6174_NIF

[QCA6174_NIF]

   DriverName = WRND32$

   ; Your adapter MAC (shown as MAC= in the status text). Required: TCP/IP copies the address at bind time,
   ; before the firmware has told the driver the real one.
   NETADDRESS = "B068E6709817"
